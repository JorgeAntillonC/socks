include("win32.sk")
FILE_SHARE_DELETE:[u4]
FILE_SHARE_WRITE:[u4]
FILE_SHARE_READ:[u4]
FILE_SHARE_ALL:[u4]

OPEN_EXISTING:[u4]
OPEN_ALWAYS:[u4]
CREATE_ALWAYS:[u4]

GENERIC_READ:[u4]
GENERIC_WRITE:[u4]
GENERIC_EXECUTE:[u4]
GENERIC_ALL:[u4]

STDOUT:[ptr]


IO_Init:() {
    4(u4) FILE_SHARE_DELETE@4
    2(u4) FILE_SHARE_WRITE@4
    1(u4) FILE_SHARE_READ@4
    3(u4) OPEN_EXISTING@4
    4(u4) OPEN_ALWAYS@4
    2(u4) CREATE_ALWAYS@4
    7(u4) FILE_SHARE_ALL@4
    0x80000000(u4) GENERIC_READ@4
    0x40000000(u4) GENERIC_WRITE@4
    0x20000000(u4) GENERIC_EXECUTE@4
    0x10000000(u4) GENERIC_ALL@4
	-11 GetStdHandle# STDOUT @8
}

IO_Print:(ptr u4){
    wb:{u4}
    STDOUT!8 @> wb null WriteFile# //
}