{
    "name": "SK Dark Warm Moody",
    "type": "dark",
    "semanticHighlighting": true,

    "colors": {
        "editorBracketHighlight.foreground1": "#8A9097",
        "editorBracketHighlight.foreground2": "#A98FB8",
        "editorBracketHighlight.foreground3": "#67A099",
        "editorBracketHighlight.foreground4": "#C08B57",
        "editorBracketHighlight.foreground5": "#8B9BB5",
        "editorBracketHighlight.foreground6": "#B06A8A",

        "editor.background": "#222327",
        "editor.foreground": "#C7C4BF",

        "editorCursor.foreground": "#DAD7D1",
        "editor.selectionBackground": "#344047",
        "editor.inactiveSelectionBackground": "#2D3338",
        "editor.lineHighlightBackground": "#272A2E",

        "editorLineNumber.foreground": "#5F656C",
        "editorLineNumber.activeForeground": "#92989F",

        "editorIndentGuide.background1": "#2D3135",
        "editorIndentGuide.activeBackground1": "#42474D",

        "editorWhitespace.foreground": "#313439",

        "editorBracketMatch.background": "#33373D",
        "editorBracketMatch.border": "#555B62",

        "sideBar.background": "#1E1F23",
        "sideBar.foreground": "#B7B4AF",
        "sideBar.border": "#2A2D32",

        "activityBar.background": "#26333B",
