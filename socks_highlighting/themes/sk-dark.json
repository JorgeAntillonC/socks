        "activityBar.inactiveForeground": "#6C747C",

        "statusBar.background": "#1E1F23",
        "statusBar.foreground": "#B7B4AF",

        "titleBar.activeBackground": "#1E1F23",
        "titleBar.activeForeground": "#C0BDB8",

        "tab.activeBackground": "#222327",
        "tab.activeForeground": "#C7C4BF",
        "tab.inactiveBackground": "#1E1F23",
        "tab.inactiveForeground": "#70757B",
        "tab.border": "#2A2D32",

        "panel.background": "#1E1F23",
        "panel.border": "#2A2D32",

        "terminal.background": "#1E1F23",
        "terminal.foreground": "#C7C4BF",

        "scrollbarSlider.background": "#4A4A5666",
        "scrollbarSlider.hoverBackground": "#5B5C6880",
        "scrollbarSlider.activeBackground": "#6C6E7A99"
